{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["src/*"],
      "cactos_tools/*": ["node_modules/@cactos/shared-types/src/*"]
    },

    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@cactos/shared-types/src"
    ],
    /* Linting */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*", "node_modules/@cactos/shared-types/src/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
